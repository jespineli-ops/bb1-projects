<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
        <#if .locale == "zh_CN">
        <link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
        <#elseif .locale == "zh_TW">
        <link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
        <#elseif .locale == "ja_JP">
        <link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
        <#elseif .locale == "ko_KR">
        <link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
        <#elseif .locale == "th_TH">
        <link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
    </#if>
    <macrolist>
        <macro id="nlheader">
            <table class="header" style="width: 100%;">
                <tr>
                    <td rowspan="3">
                        <#if subsidiary.logo?length != 0>
                        <@filecabinet nstype="image" style="float: left; margin: 7px;" src="${subsidiary.logo@Url}" width="200px" height="40px"/>
                    </#if>
                    <div style="font-size:8pt; margin-top:5px;">
                        <#if subsidiary.name?has_content && !(subsidiary.mainaddress_text?lower_case?contains(subsidiary.name?lower_case))>
                        <strong>${subsidiary.name}</strong><br/>
                    </#if>
                            ${subsidiary.mainaddress_text}<br/>
                    VAT No.: ${subsidiary.federalidnumber}
                </div>
            </td>
            <td style="line-height:140%;"></td>
            <td align="right"><span class="title">${record@title}</span></td>
        </tr>
        <tr>
            <td></td>
            <td align="right"><span class="number">#${record.tranid}</span></td>
        </tr>
        <tr>
            <td></td>
            <td align="right">${record.trandate}</td>
        </tr>
    </table>
</macro>
<macro id="nlfooter">
<table class="footer" style="width: 100%;">
    <tr>
        <td></td>
        <td align="right"><pagenumber/> of <totalpages/></td>
    </tr>
</table>
</macro>
        </macrolist>
<style>
* {
<#if .locale == "zh_CN">
font-family: NotoSans, NotoSansCJKsc, sans-serif;
<#elseif .locale == "zh_TW">
font-family: NotoSans, NotoSansCJKtc, sans-serif;
<#elseif .locale == "ja_JP">
font-family: NotoSans, NotoSansCJKjp, sans-serif;
<#elseif .locale == "ko_KR">
font-family: NotoSansCJKkr, sans-serif;
<#elseif .locale == "th_TH">
font-family: NotoSansThai, sans-serif;
<#else>
font-family: NotoSans, sans-serif;
</#if>
        }
        table {
        font-size: 9pt;
        table-layout: fixed;
        }
        th {
        font-weight: bold;
        font-size: 8pt;
        vertical-align: middle;
        padding: 5px 6px 3px;
        background-color: #e3e3e3;
        color: #333333;
        }
        td {
        padding: 4px 6px;
        }
        td p {
        align: left
        }
        b {
        font-weight: bold;
        color: #333333;
        }
        table.header td {
        padding: 0px;
        font-size: 10pt;
        }
        table.footer td {
        padding: 0px;
        font-size: 8pt;
        }
        table.itemtable th {
        padding-bottom: 10px;
        padding-top: 10px;
        }
        table.body td {
        padding-top: 2px;
        }
        table.total {
        page-break-inside: avoid;
        }
        tr.totalrow {
        background-color: #e3e3e3;
        line-height: 200%;
        width: 50%;
        }
        td.totalboxtop {
        font-size: 10pt;
        background-color: #e3e3e3;
        }
        td.addressheader {
        font-size: 8pt;
        padding-top: 6px;
        padding-bottom: 2px;
        }
        td.address {
        padding-top: 0px;
        }
        td.totalboxmid {
        font-size: 22pt;
        padding-top: 10px;
        background-color: #e3e3e3;
        }
        td.totalboxbot {
        background-color: #e3e3e3;
        font-weight: bold;
        }
        span.title {
        font-size: 28pt;
        }
        span.number {
        font-size: 16pt;
        }
        span.itemname {
        font-weight: bold;
        line-height: 150%;
        }
        hr {
        width: 100%;
        color: #d3d3d3;
        background-color: #d3d3d3;
        height: 1px;
        }
        </style>
        </head>
<body header="nlheader" header-height="15%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
<table style="width: 100%; margin-top: 10px;">
    <tr>
        <td class="addressheader" colspan="5"><strong>${record.billaddress@label}</strong></td>
    </tr>
    <tr>
        <td class="address" colspan="5" rowspan="2">${record.billaddress}</td>
    </tr>
    <tr>
        <td class="totalboxbot" colspan="3" align="right"><strong>${record.duedate@label}:</strong> ${record.duedate}</td>
    </tr>
</table>

<#if record.custbody_bank_details?has_content>
<table style="margin-top:15px; font-size:10pt; width:100%;">
    <tr>
        <td style="width:60%; vertical-align:top;">
            <strong>Bank Details:</strong><br/>
            ${record.custbody_bank_details?html}
        </td>
        <td style="width:40%;"></td>
    </tr>
</table>
</#if>

<table class="body" style="width: 100%; margin-top: 10px;">
<tr>
    <th>${record.terms@label}</th>
    <th>${record.duedate@label}</th>
</tr>
<tr>
    <td>${record.terms}</td>
    <td>${record.duedate}</td>
</tr>
</table>

<#if record.item?has_content>
<table class="itemtable" style="width: 100%; margin-top: 10px;">
<#list record.item as item>
<#if item_index==0>
<thead>
    <tr>
        <th style="width: 46%;" colspan="12">${item.item@label}</th>
        <th style="width: 14%;" colspan="2" align="center">Count</th>
        <th style="width: 15%;" colspan="4" align="center">${item.rate@label}</th>
        <th style="width: 16%;" colspan="2" align="center">Tax Amount</th>
        <th style="width: 15%;" colspan="4" align="center">${item.amount@label}</th>
    </tr>
</thead>
</#if>
<tr>
<td style="width: 46%;" colspan="12"><span class="itemname">${item.item}</span><br />${item.description}</td>
<td style="width: 14%;" colspan="2" align="center">${item.quantity}</td>
<td style="width: 15%;" colspan="4" align="center">${item.rate}</td>
<td style="width: 16%;" colspan="2" align="center">${item.tax1amt}</td>
<td style="width: 15%;" colspan="4" align="center">${item.amount}</td>
</tr>
        </#list>
        </table>
<hr />
        </#if>

<table class="total" style="width: 100%; margin-top: 10px;">
<tr>
    <td colspan="4">&nbsp;</td>
    <td align="right"><strong>${record.subtotal@label}</strong></td>
    <td align="right">${record.subtotal}</td>
</tr>
<tr>
    <td colspan="4">&nbsp;</td>
    <td align="right"><strong>${record.taxtotal@label} (${record.taxrate}%)</strong></td>
    <td align="right">${record.taxtotal}</td>
</tr>
<tr class="totalrow">
    <td colspan="4">&nbsp;</td>
    <td align="right"><strong>${record.total@label}</strong></td>
    <td align="right">${record.total}</td>
</tr>
</table>

<#if record.custbodycustbody_bank_info?has_content>
<table style="margin-top:15px; font-size:10pt; width:100%;">
<tr>
    <td style="width:100%; vertical-align:top;">
        <strong>Bank Information:</strong><br/>
        <pre style="font-family:NotoSans, sans-serif; font-size:10pt;">
            ${record.custbodycustbody_bank_info}
        </pre>
    </td>
</tr>
</table>
        </#if>
        </body>
        </pdf>
